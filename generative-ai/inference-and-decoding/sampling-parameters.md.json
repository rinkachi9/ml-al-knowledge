  "concepts": [
    {
      "term": "Temperature",
      "anchor": "#temperature-controlling-randomness",
      "definition": "A divisor of the logits that sharpens or flattens the output distribution."
    },
    {
      "term": "Top-k sampling",
      "anchor": "#top-k-sampling-controlling-diversity",
      "definition": "Sampling only from the k most probable tokens."
    },
    {
      "term": "Top-p sampling",
      "anchor": "#top-p-sampling-nucleus-sampling-dynamic-control",
      "definition": "Sampling from the smallest set of tokens whose probabilities reach p."
    }
  ],
