  "concepts": [
    {
      "term": "Rational agent",
      "anchor": "#definition",
      "definition": "A system that selects the action expected to maximize its performance measure given what it perceives and knows."
    },
    {
      "term": "Symbolic AI",
      "anchor": "#symbolic-and-subsymbolic-ai",
      "definition": "AI that represents knowledge explicitly with symbols, rules and logic."
    },
    {
      "term": "Narrow AI",
      "anchor": "#narrow-and-general-ai",
      "definition": "AI that solves one task or a bounded family of tasks."
    }
