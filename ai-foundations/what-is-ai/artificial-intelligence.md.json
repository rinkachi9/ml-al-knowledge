  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "How do symbolic and subsymbolic AI differ in how they store knowledge?",
      "a": "Symbolic AI stores it explicitly as rules and logic; subsymbolic AI stores it implicitly in learned numeric parameters.",
      "anchor": "#symbolic-and-subsymbolic-ai",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Which two axes does Russell and Norvig's classification of AI definitions use?",
      "a": "Thinking versus behavior, and human performance versus rationality.",
