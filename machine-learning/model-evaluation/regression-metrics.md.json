    {
      "term": "RMSE",
      "anchor": "#definitions",
      "definition": "The square root of the mean squared error, in the unit of the target."
    },
    {
      "term": "R squared",
      "anchor": "#definitions",
      "definition": "The fraction of the target's variance explained by the model."
    }
