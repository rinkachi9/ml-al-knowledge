  "concepts": [
    {
      "term": "Overfitting",
      "anchor": "#definitions",
      "definition": "Learning the noise of the training data so that performance on new data is poor."
    },
    {
      "term": "Underfitting",
      "anchor": "#definitions",
      "definition": "A model too simple to capture the patterns, with high error even on training data."
    },
    {
      "term": "Bias-variance trade off",
      "anchor": "#the-bias-and-variance-trade-off",
      "definition": "Raising capacity lowers bias and raises variance; the best model minimizes their sum."
    }
  ],
  "questions": [
