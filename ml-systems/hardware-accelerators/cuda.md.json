  "concepts": [
    {
      "term": "Kernel",
      "anchor": "#the-programming-model",
      "definition": "A function that runs on the GPU, executed by many threads in parallel."
    },
    {
      "term": "Warp",
      "anchor": "#the-programming-model",
      "definition": "A group of 32 threads executed in lockstep."
    },
    {
      "term": "Coalesced memory access",
      "anchor": "#how-cuda-powers-gpu-performance",
      "definition": "Consecutive threads reading consecutive addresses so the hardware combines the reads."
    }
